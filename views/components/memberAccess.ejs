<div class="max-w-2xl mx-auto px-4 mb-8 mt-8">
  <div x-data="{ showInput: <%= showInput === true ? 'true' : 'false'  %>, passcode: '' }" class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl transition-all duration-500" :class="showInput ? 'border-orange-500/50 ring-1 ring-orange-500/20' : ''">
    <div class="px-6 py-4 flex items-center justify-between bg-zinc-950/50">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-zinc-900 rounded-lg border border-zinc-800">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-black uppercase italic tracking-tighter text-zinc-100">Official <span class="text-orange-500">Membership</span></h3>
          <p class="text-[10px] text-zinc-500 uppercase tracking-widest font-bold">Unlock exclusive club features</p>
        </div>
      </div>

      <button @click="showInput = !showInput" class="text-[10px] font-black uppercase tracking-widest px-4 py-2 rounded-full border border-zinc-800 hover:bg-zinc-800 transition-all text-zinc-400" x-text="showInput ? 'Close' : 'Enter Key'"></button>
    </div>

    <div x-show="showInput" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="p-6 border-t border-zinc-800 bg-zinc-900">
      <form action="/membership/verify?_method=PATCH" method="POST" class="space-y-4">
        <div>
          <label for="passcode" class="block text-[10px] font-bold uppercase tracking-widest text-zinc-500 mb-2 ml-1">Secret Club Passcode</label>
          <div class="relative">
            <input type="password" id="passcode" name="passcode" maxlength="20" x-model="passcode" placeholder="••••••••" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl py-4 px-5 text-orange-500 placeholder:text-zinc-800 focus:ring-2 focus:ring-orange-500/50 outline-none transition-all font-mono tracking-widest text-center" required>
            <% errors.forEach(error => { %>
            <% if (error.path === 'passcode') { %>
            <p class="text-red-500 text-center"><%= error.msg %></p>
            <% } %>
            <% }) %>
          </div>
        </div>

        <button type="submit" class="w-full bg-orange-600 hover:bg-orange-500 text-white font-black uppercase py-3 rounded-xl text-xs tracking-[0.2em] transition-all active:scale-95 shadow-lg shadow-orange-900/20" :disabled="passcode.length < 1" :class="passcode.length < 1 ? 'opacity-50 grayscale cursor-not-allowed' : ''">
          Verify Credentials
        </button>
      </form>

      <p class="mt-4 text-center text-[9px] text-zinc-600 uppercase tracking-tighter">
        Note: Unauthorized access attempts are logged by the system.
      </p>
    </div>
  </div>
</div>