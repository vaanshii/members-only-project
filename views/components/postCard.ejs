<div x-data="{ expanded: false, confirmDelete: false }" class="max-w-2xl mx-auto px-4 mb-6 mt-10">

  <article class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-sm hover:border-zinc-700 transition-colors relative">

    <div class="p-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <%- include('../partials/generatedAvatarProfile', {username: postData.username}) %>

        <div>
          <a href="/profile/<%= postData.username %>" class="text-sm font-bold text-zinc-100 hover:text-orange-500 cursor-pointer transition-colors leading-none">
            <%= postData?.username || 'Anonymous' %>
          </a>
          <p class="text-[10px] text-orange-500 uppercase tracking-widest font-medium">
            <%= postData?.motorcycle || 'currently walking' %>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <time class="text-[11px] text-zinc-500 font-medium">
          <%= postData?.created_at || 'some time ago' %>
        </time>

        <% if ((locals.user && locals.user.username === postData.username) || locals.user?.is_admin) { %>
        <button @click="confirmDelete = true" class="text-zinc-600 hover:text-red-500 transition-colors p-1" title="Delete Post">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
        <% } %>
      </div>
    </div>

    <div class="px-4 pb-4">
      <h2 class="text-lg md:text-xl font-black italic tracking-tighter text-zinc-100 uppercase mb-2 leading-tight">
        <%= postData.title %>
      </h2>

      <p class="text-sm md:text-base text-zinc-400 leading-relaxed transition-all duration-300" :class="expanded ? '' : 'line-clamp-3'">
        <%= postData.content %>
      </p>

      <% if (postData.content.length > 200) { %>
      <button @click="expanded = !expanded" class="mt-3 text-xs font-bold text-orange-500 hover:text-orange-400 uppercase tracking-wider flex items-center gap-1">
        <span x-text="expanded ? 'Collapse' : 'Expand'"></span>
        <svg xmlns="http://www.w3.org/2000/svg" :class="expanded ? 'rotate-180' : ''" class="h-3 w-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <% } %>
    </div>

    <div class="px-4 py-3 border-t border-zinc-800/50 bg-zinc-900/50 flex items-center gap-6">
      <button class="group flex items-center gap-2 text-zinc-500 hover:text-orange-500 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-active:scale-125 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
        </svg>
        <span class="text-xs font-bold">12</span>
      </button>

      <button class="group flex items-center gap-2 text-zinc-500 hover:text-sky-500 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <span class="text-xs font-bold">5</span>
      </button>
    </div>

    <div x-show="confirmDelete" x-transition.opacity class="absolute inset-0 z-10 bg-zinc-950/90 backdrop-blur-sm flex flex-col items-center justify-center p-6 text-center" style="display: none;">
      <p class="text-sm font-bold text-zinc-100 uppercase tracking-tighter italic">Scrap this post permanently?</p>
      <div class="flex gap-3 mt-4">
        <form action="/post-message/delete/<%= postData.id %>?_method=DELETE" method="POST">
          <button type="submit" class="bg-red-600 hover:bg-red-500 text-white text-[10px] font-black uppercase px-4 py-2 rounded-lg tracking-widest transition-all">
            Confirm Delete
          </button>
        </form>
        <button @click="confirmDelete = false" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-[10px] font-black uppercase px-4 py-2 rounded-lg tracking-widest transition-all">
          Cancel
        </button>
      </div>
    </div>

  </article>
</div>